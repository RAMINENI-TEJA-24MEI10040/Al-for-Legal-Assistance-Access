# LegalEase AI Environment Configuration

# Google Gemini API Settings
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-004

# Database Configuration (Local Storage SQL)
DATABASE_PATH=legalease.db

# Security & Auth Settings
SECRET_KEY=legalease-ai-super-secret-enterprise-key-min-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Concurrency Limits
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENT_PAGES=500
MAX_DECOMPRESSION_RATIO=10
